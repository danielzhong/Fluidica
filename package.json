{
  "name": "fluidica",
  "version": "1.0.0",
  "private": true,
  "description": "Fluidica — AI-designed microfluidics, manufactured on demand. Based on Automark Astro by Themefisher.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/themeGenerator.js && astro dev --host 0.0.0.0",
    "build": "node scripts/themeGenerator.js && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "playwright test",
    "format": "prettier --write src tests scripts astro.config.mjs playwright.config.ts package.json README.md"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.3.3",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
