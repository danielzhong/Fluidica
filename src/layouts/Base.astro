---
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import "../styles/main.css";
import "../styles/dark.css";
import "../styles/motion.css";
import "../styles/interactions.css";
import Header from "./partials/Header.astro";
import Footer from "./partials/Footer.astro";
import ProjectDialog from "./components/ProjectDialog.astro";
import BackToTop from "./components/BackToTop.astro";
import Motion from "./components/Motion.astro";
import { site } from "../config/site";
import { withBase } from "../lib/paths";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
} = Astro.props;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const shareImage = withBase("/images/fluidica-chip.png");
const shareImageURL = Astro.site
  ? new URL(shareImage, Astro.site).href
  : shareImage;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1220" />
    <script is:inline>
      // Apply the saved preference before the page paints. New visitors see dark mode.
      let theme = "dark";
      try {
        if (localStorage.getItem("fluid-fabs-theme") === "light")
          theme = "light";
      } catch {}
      document.documentElement.dataset.theme = theme;
      document
        .querySelector('meta[name="theme-color"]')
        .setAttribute("content", theme === "dark" ? "#0b1220" : "#f8faff");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={shareImageURL} />
    <meta
      property="og:image:alt"
      content="A transparent microfluidic chip with blue and violet fluid channels"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  </head>
  <body id="top" tabindex="-1">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ProjectDialog />
    <BackToTop />
    <Motion />
  </body>
</html>
