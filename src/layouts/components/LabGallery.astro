---
import Icon from "./Icon.astro";
import { labPhotos } from "../../content/homepage/lab";
import { withBase } from "../../lib/paths";
import { site } from "../../config/site";
---

<section class="section lab-section" id="lab" aria-labelledby="lab-heading">
  <div class="container">
    <div class="lab-heading">
      <div>
        <span class="eyebrow">FROM OUR LAB</span>
        <h2 id="lab-heading">
          Built in our lab.
          <br />
          <span>Made for yours.</span>
        </h2>
        <span class="lab-origin">
          <span></span> Real chips. Real experiments. Our own work.
        </span>
      </div>
      <div class="lab-story">
        <p>
          We started with the same frustration: off-the-shelf chips were
          expensive and difficult to adapt to our experiments. So we began
          3D-printing and using our own.
        </p>
        <p>
          {site.name} grew from that hands-on experience—with a simple goal:
          make custom microfluidics more practical, affordable, and accessible.
        </p>
      </div>
    </div>

    <div
      class="lab-gallery"
      aria-label={`Photographs from the ${site.name} lab`}
    >
      {labPhotos.map((photo, index) => (
        <figure class:list={["lab-photo", `lab-photo-${photo.layout}`]}>
          <a
            href={withBase(photo.src)}
            data-lab-photo
            data-title={photo.title}
            data-caption={photo.caption}
            aria-label={`View lab photo ${index + 1}: ${photo.title}`}
            aria-haspopup="dialog"
          >
            <img
              src={withBase(photo.src)}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
            <span class="photo-expand" aria-hidden="true">
              <Icon name="diagonal" size={17} />
            </span>
            {photo.layout === "feature" && (
              <span class="photo-label">ON THE BENCH / {site.name} LAB</span>
            )}
          </a>
          <figcaption>
            <span class="photo-number">0{index + 1}</span>
            <span>{photo.title}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="lab-bottom">
      <p>
        Designed, printed, and used by our team.
        <br />
        <span>Select a photo to explore the original image.</span>
      </p>
      <button class="text-button" data-project-trigger>
        Build a chip around your experiment <Icon name="arrow" size={19} />
      </button>
    </div>
  </div>
</section>

<dialog
  class="lab-viewer"
  id="lab-viewer"
  aria-labelledby="lab-viewer-title"
  aria-describedby="lab-viewer-caption"
>
  <div class="viewer-top">
    <span>
      FROM OUR LAB{" "}
      <span class="viewer-counter" aria-live="polite">
        1 / 7
      </span>
    </span>
    <button class="viewer-close" type="button" aria-label="Close lab photo">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
  <div class="viewer-image-frame">
    <img class="viewer-image" alt="" />
  </div>
  <div class="viewer-bottom">
    <div>
      <h3 id="lab-viewer-title">Lab photograph</h3>
      <p id="lab-viewer-caption"></p>
    </div>
    <div class="viewer-navigation">
      <button
        type="button"
        class="viewer-previous"
        aria-label="Previous lab photo"
      >
        <Icon name="arrow" size={21} />
      </button>
      <button type="button" class="viewer-next" aria-label="Next lab photo">
        <Icon name="arrow" size={21} />
      </button>
    </div>
  </div>
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>("#lab-viewer");
  const photoLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-lab-photo]"),
  );
  if (viewer && photoLinks.length) {
    const image = viewer.querySelector<HTMLImageElement>(".viewer-image")!;
    const title = viewer.querySelector<HTMLElement>("#lab-viewer-title")!;
    const caption = viewer.querySelector<HTMLElement>("#lab-viewer-caption")!;
    const counter = viewer.querySelector<HTMLElement>(".viewer-counter")!;
    let currentIndex = 0;
    const showPhoto = (index: number) => {
      currentIndex = (index + photoLinks.length) % photoLinks.length;
      const photo = photoLinks[currentIndex];
      image.src = photo.href;
      image.alt = photo.querySelector("img")?.alt || "";
      title.textContent = photo.dataset.title || "Lab photograph";
      caption.textContent = photo.dataset.caption || "";
      counter.textContent = `${currentIndex + 1} / ${photoLinks.length}`;
    };
    photoLinks.forEach((link, index) =>
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        showPhoto(index);
        viewer.showModal();
      }),
    );
    viewer
      .querySelector(".viewer-close")
      ?.addEventListener("click", () => viewer.close());
    viewer
      .querySelector(".viewer-previous")
      ?.addEventListener("click", () => showPhoto(currentIndex - 1));
    viewer
      .querySelector(".viewer-next")
      ?.addEventListener("click", () => showPhoto(currentIndex + 1));
    viewer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        showPhoto(currentIndex + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
    viewer.addEventListener("click", (event) => {
      if (event.target !== viewer) return;
      const rect = viewer.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        viewer.close();
    });
  }
</script>

<style>
  .lab-section {
    border-top: 1px solid var(--line);
    background: #f0f4fa;
  }
  .lab-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 80px;
    margin-bottom: 37px;
  }
  .lab-heading h2 {
    font-size: 44px;
  }
  .lab-origin {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: #5b6c87;
    margin-top: 24px;
  }
  .lab-origin > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #688ace;
    box-shadow: 0 0 0 4px #e0e8f6;
  }
  .lab-story p {
    font-size: 12px;
    line-height: 1.95;
    color: #5d6b82;
  }
  .lab-story p + p {
    margin-top: 13px;
  }
  .lab-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .lab-photo {
    margin: 0;
    border: 1px solid #d6dfed;
    background: #fff;
    border-radius: 9px;
    overflow: hidden;
  }
  .lab-photo > a {
    display: block;
    overflow: hidden;
    position: relative;
    background: #1d2739;
  }
  .lab-photo > a:focus-visible {
    outline-offset: -4px;
  }
  .lab-photo img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .lab-photo > a:hover img {
    transform: scale(1.025);
  }
  .lab-photo figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    min-height: 47px;
    font-size: 10px;
    line-height: 1.5;
    color: #3e4e69;
  }
  .photo-number {
    flex-shrink: 0;
    font-size: 8px;
    font-variant-numeric: tabular-nums;
    color: #657690;
    letter-spacing: 0.05em;
  }
  .lab-photo-feature {
    grid-column: span 2;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
  }
  .lab-photo-feature > a {
    flex: 1;
  }
  .lab-photo-feature img {
    height: 100%;
    position: absolute;
    object-position: 50% 57%;
  }
  .lab-photo-feature figcaption {
    min-height: 54px;
    font-size: 12px;
    padding: 14px 19px;
  }
  .lab-photo-detail,
  .lab-photo-micrograph {
    grid-column: span 2;
  }
  .lab-photo-detail img {
    height: 200px;
    object-position: 50% 61%;
  }
  .lab-photo-micrograph img {
    height: 160px;
    object-fit: contain;
    background: #e8ecef;
  }
  .lab-photo-micrograph > a {
    background: #e8ecef;
  }
  .lab-photo-prototypes img {
    object-fit: contain;
    background: #097f74;
  }
  .photo-expand {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 31px;
    height: 31px;
    display: grid;
    place-items: center;
    background: #142038bb;
    backdrop-filter: blur(8px);
    border: 1px solid #ffffff44;
    border-radius: 6px;
    color: #fff;
  }
  .photo-label {
    position: absolute;
    bottom: 17px;
    left: 17px;
    border: 1px solid #ffffff44;
    border-radius: 4px;
    background: #111d32d9;
    padding: 6px 9px;
    color: #ecf1ff;
    letter-spacing: 0.1em;
    font-size: 8px;
  }
  .lab-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
  }
  .lab-bottom p {
    font-size: 11px;
    color: #53647f;
    line-height: 1.85;
  }
  .lab-bottom p > span {
    color: #586980;
    font-size: 10px;
  }
  .lab-bottom .text-button {
    font-size: 12px;
  }
  .lab-viewer {
    width: min(1100px, calc(100% - 40px));
    max-height: 94dvh;
    margin: auto;
    border: 1px solid #3c475a;
    border-radius: 13px;
    padding: 0;
    background: #131c2c;
    color: #fff;
    overflow: auto;
    box-shadow: 0 24px 80px #06102255;
  }
  .lab-viewer::backdrop {
    background: #071124d9;
    backdrop-filter: blur(9px);
  }
  :global(body:has(#lab-viewer[open])) {
    overflow: hidden;
  }
  .viewer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 13px 20px;
    border-bottom: 1px solid #ffffff20;
  }
  .viewer-top > span {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #d2daea;
  }
  .viewer-counter {
    margin-left: 17px;
    color: #b2c3e2;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  .viewer-close {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #ffffff12;
    color: #fff;
    flex-shrink: 0;
  }
  .viewer-close:hover,
  .viewer-navigation button:hover {
    background: #ffffff24;
  }
  .viewer-image-frame {
    display: grid;
    place-items: center;
    background: #0a1220;
  }
  .viewer-image {
    width: 100%;
    height: min(66dvh, 680px);
    object-fit: contain;
  }
  .viewer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    padding: 20px 24px;
  }
  .viewer-bottom h3 {
    font-size: 20px;
    color: #f5f7ff;
    letter-spacing: -0.025em;
  }
  .viewer-bottom p {
    margin-top: 7px;
    color: #b7c2d7;
    font-size: 12px;
    line-height: 1.7;
  }
  .viewer-navigation {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .viewer-navigation button {
    display: grid;
    place-items: center;
    background: #ffffff10;
    color: #fff;
    border: 1px solid #ffffff26;
    width: 42px;
    height: 42px;
    border-radius: 6px;
  }
  .viewer-previous :global(svg) {
    transform: rotate(180deg);
  }
  @media (max-width: 899px) {
    .lab-heading {
      gap: 34px;
    }
    .lab-heading h2 {
      font-size: 36px;
    }
    .lab-story p {
      font-size: 11px;
    }
    .lab-origin {
      font-size: 9px;
    }
    .lab-gallery {
      gap: 12px;
    }
    .lab-photo img {
      height: 130px;
    }
    .lab-photo-feature img {
      height: 100%;
    }
    .lab-photo-detail img {
      height: 180px;
    }
    .lab-photo-micrograph img {
      height: 140px;
    }
    .lab-photo figcaption {
      font-size: 9px;
      padding: 10px;
      gap: 7px;
    }
    .lab-photo-feature figcaption {
      font-size: 10px;
      padding: 14px;
    }
    .lab-bottom .text-button {
      font-size: 11px;
    }
  }
  @media (max-width: 600px) {
    .lab-heading {
      grid-template-columns: 1fr;
      gap: 23px;
      margin-bottom: 26px;
    }
    .lab-heading h2 {
      font-size: 32px;
    }
    .lab-origin {
      margin-top: 18px;
    }
    .lab-story p {
      font-size: 11px;
    }
    .lab-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .lab-photo-feature {
      grid-row: auto;
    }
    .lab-photo-feature > a {
      aspect-ratio: 4 / 3;
    }
    .lab-photo-detail,
    .lab-photo-micrograph {
      grid-column: auto;
    }
    .lab-photo-detail img,
    .lab-photo-micrograph img,
    .lab-photo img {
      height: 135px;
    }
    .lab-photo-feature img {
      height: 100%;
    }
    .lab-photo-detail img {
      object-position: 55% 70%;
    }
    .lab-photo figcaption {
      align-items: baseline;
      min-height: 50px;
      font-size: 9px;
    }
    .lab-photo-feature figcaption {
      min-height: 45px;
      font-size: 11px;
    }
    .photo-expand {
      width: 27px;
      height: 27px;
      top: 8px;
      right: 8px;
    }
    .photo-label {
      font-size: 7px;
      bottom: 12px;
      left: 12px;
    }
    .lab-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
      margin-top: 21px;
    }
    .lab-bottom p,
    .lab-bottom .text-button {
      font-size: 11px;
    }
    .lab-bottom p > span {
      font-size: 9px;
    }
    .lab-viewer {
      width: calc(100% - 22px);
      max-height: 94dvh;
    }
    .viewer-top {
      padding: 9px 13px;
    }
    .viewer-image {
      height: 54dvh;
    }
    .viewer-bottom {
      align-items: flex-start;
      padding: 18px;
      gap: 15px;
      flex-direction: column;
    }
    .viewer-bottom h3 {
      font-size: 19px;
    }
    .viewer-bottom p {
      font-size: 11px;
    }
    .viewer-navigation {
      align-self: flex-end;
    }
  }
</style>
