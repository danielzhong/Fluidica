---
import { faqs } from "../../content/homepage/content";
import Icon from "./Icon.astro";
---

<section class="section faq-section" id="faq">
  <div class="container faq-layout">
    <div class="faq-intro">
      <span class="eyebrow">A LITTLE MORE CLARITY</span>
      <h2>
        Good questions.
        <br />
        Clear answers.
      </h2>
      <p>
        Have something more specific in mind?
        <br />
        Let’s talk about your project.
      </p>
      <button class="text-button" data-project-trigger>
        Get in touch <Icon name="arrow" size={19} />
      </button>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" name="faq">
          <summary>
            <span class="faq-number">0{index + 1}</span>
            <span>{faq.question}</span>
            <Icon name="plus" size={19} />
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
